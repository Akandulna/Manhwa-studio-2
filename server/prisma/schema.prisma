// Prisma schema for Manhwa Studio
// SQLite database for storing series, chapters, and page metadata

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Series {
  id           String    @id @default(uuid())
  title        String
  sourceSite   String
  coverPath    String?
  rootFolder   String
  urlTemplate  String?
  aboutSummary String?   // Module 2: AI-generated "about this manhwa" overview
  createdAt    DateTime  @default(now())
  chapters     Chapter[]
  videoProjects VideoProject[] // Module 4: Video Editor
  watermarkTemplates WatermarkTemplate[] // Module 3: per-series watermark templates
}

// Module 3: Image Clipper — a per-series watermark template used to auto-detect
// (OpenCV template matching) and white-fill site watermarks during crop export.
// The template image is a small PNG saved on disk under <DOWNLOAD_ROOT>/_watermarks/.
model WatermarkTemplate {
  id        String   @id @default(uuid())
  seriesId  String
  label     String   @default("Watermark")
  imagePath String   // absolute path to the template PNG on disk
  width     Int      // template width in px
  height    Int      // template height in px
  threshold Float    @default(0.8)  // match confidence cutoff (0-1) for TM_CCOEFF_NORMED
  enabled   Boolean  @default(true) // include in detection during export
  createdAt DateTime @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
}

model Chapter {
  id              String         @id @default(uuid())
  seriesId        String
  number          Float
  title           String?
  sourceUrl       String?
  folderPath      String
  status          String         @default("pending") // pending, queued, downloading, done, failed, skipped
  pageCount       Int?
  downloadedCount Int            @default(0)
  error           String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?      // Its Part was completed on the Storage page: files deleted, only script continuity kept (partArchive.ts)
  completedPart   Int?           // Which narration Part that was
  
  series          Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  pages           Page[]
  scripts         ChapterScript[] // Module 2: Narration scripts, one per language
  audioSections   AudioSection[]  // Module 2: Voiceover sections (per language)
  audioFiles      AudioFile[]     // Module 2: Audio files (per-section + joined, per language)
  audioAnalyses   AudioAnalysis[] // Module 2: Voice consistency analysis, one per language
  cropSession     CropSession?   // Module 3: Image Clipper
  aiSuggestions   AISuggestion[] // Module 3 AI: Auto-crop suggestions for this chapter
  cropPointSet    CropPointSet?  // Module 3 v2: Image Clipper 2.0 pointer set
  phoneSend       PhoneChapterSend? // Sleeper-Cell: this chapter's zip sent to the phone through R2

  @@unique([seriesId, number])
}

// Sleeper-Cell: each chapter is sent to the phone as its own zip in R2
// (<phone prefix>manhwa/<Series>/<Chapter>.zip, see services/phoneSend.ts),
// so new chapters join the series on the phone and done ones can be cleared there.
model PhoneChapterSend {
  chapterId   String    @id
  seriesId    String
  key         String?   // R2 key of the chapter zip; null once deleted (cleared on the phone)
  etag        String?
  fingerprint String?   // over the pages sent (name + size), to tell a changed chapter
  files       Int       @default(0)
  bytes       Int       @default(0)
  sentAt      DateTime? // null: never sent one by one (cleared from an older whole-series copy)
  clearedAt   DateTime? // the phone cleared it; it isn't sent again unless picked by hand

  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([seriesId])
}

model Page {
  id        String  @id @default(uuid())
  chapterId String
  index     Int
  sourceUrl String?
  localPath String?
  status    String  @default("pending") // pending, done, failed
  bytes     Int?
  
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  @@unique([chapterId, index])
}

model Setting {
  key   String @id
  value String
}

// Module 2: Narration Studio - Chapter script and continuity metadata
model ChapterScript {
  id               String   @id @default(uuid())
  chapterId        String
  language         String   @default("en") // Narration language: en | hi (each has its own script, continuity and parts)
  provider         String?  // AI provider used (gemini, openai, etc.)
  model            String?  // Model name used
  mode             String   @default("api") // api | manual
  scriptPath       String?  // Path to script file on disk
  status           String   @default("none") // none, generating, done, failed, edited, stale
  rollingSummary   String?  // Cumulative story summary through this chapter
  closingParagraph String?  // Exact last paragraph (seam for next chapter)
  isPartEnd        Boolean  @default(false) // Does this chapter end a Part?
  outroText        String?  // Closing/epilogue lines (only when isPartEnd=true)
  error            String?  // Error message if failed
  tokensUsed       Int?     // Optional token count
  sourceSha256     String?  // Hindi only: SHA-256 of the trimmed English script it was converted from (stale once that changes)
  review           String?  // Hindi only: JSON array of check issues when saved despite failing the check; null = passed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  chapter          Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, language])
}

// Module 2: Narration Studio - Voiceover audio sections
model AudioSection {
  id        String   @id @default(uuid())
  chapterId String
  language  String   @default("en") // Narration language: en | hi
  index     Int      // Reading order within the chapter
  text      String   // The section's script text
  status    String   @default("none") // none, generating, done, failed
  error     String?
  timelineScript String? // Module 4v2: "script with timeline" text; non-empty = ready
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  audioFile AudioFile?  // The audio file for this section (if generated/uploaded)
  
  @@unique([chapterId, language, index])
}

// Module 2: Narration Studio - Voiceover audio files
model AudioFile {
  id         String   @id @default(uuid())
  chapterId  String
  sectionId  String?  @unique // Null for joined chapter audio
  language   String   @default("en") // Narration language: en | hi
  kind       String   // generated, uploaded, joined
  provider   String?  // TTS provider (for generated)
  model      String?  // TTS model (for generated)
  voice      String?  // Voice name (for generated - cheap consistency signal)
  filePath   String   // Path on disk
  originalName String? // Original filename of an uploaded file (for duplicate detection)
  format     String?  // wav, mp3, etc.
  durationMs Int?     // Duration in milliseconds
  sampleRate Int?     // Sample rate in Hz
  bytes      Int?     // File size in bytes
  status     String   @default("pending") // pending, done, failed
  error      String?
  createdAt  DateTime @default(now())
  
  chapter    Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  section    AudioSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
}

// Module 2: Narration Studio - Voice consistency analysis results
model AudioAnalysis {
  id        String   @id @default(uuid())
  chapterId String
  language  String   @default("en") // Narration language: en | hi
  threshold Float    // Similarity threshold used
  verdict   String   // consistent, mismatch, inconclusive
  details   String   // JSON: per-file scores, outlier ids, pairwise matrix
  createdAt DateTime @default(now())
  
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, language])
}

// Module 3: Image Clipper — Crop session per chapter
model CropSession {
  id          String   @id @default(uuid())
  chapterId   String   @unique
  status      String   @default("active")  // active, finalized
  cropCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter       Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  crops         Crop[]
  events        CropEvent[]
  aiSuggestions AISuggestion[] // Module 3 AI: Auto-crop suggestions for this session
}

// Module 3: Image Clipper — Individual crop geometry
model Crop {
  id            String   @id @default(uuid())
  sessionId     String
  sequence      Int      // Display order (1-based)

  // Source coordinates (pixels, relative to virtual canvas)
  canvasX       Float
  canvasY       Float
  canvasW       Float
  canvasH       Float

  // Normalized coordinates (0-1, relative to full canvas dimensions)
  normX         Float
  normY         Float
  normW         Float
  normH         Float

  // Source image mapping (which source files this crop spans)
  sourceFiles   String   // JSON array of { filename, startY, endY }

  aspectRatio   String?  // "16:9", "9:16", "1:1", "free", etc.
  exportPath    String?  // Set on finalize

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       CropSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events        CropEvent[]

  @@unique([sessionId, sequence])
}

// Module 3: Image Clipper — Lifecycle events for AI training
model CropEvent {
  id          String   @id @default(uuid())
  sessionId   String
  cropId      String?
  action      String   // created, resized, moved, deleted, finalized
  payload     String?  // JSON: snapshot of coordinates at event time
  createdAt   DateTime @default(now())

  session     CropSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  crop        Crop?       @relation(fields: [cropId], references: [id], onDelete: SetNull)
}

// Module 3 AI: Auto-Crop — a versioned, locally-trained style model.
// Artifacts live on disk under server/ml/models/v{version}/.
// The active version for inference is stored in the Setting table
// under key "aiCrop.activeModelVersion".
model AIModel {
  id                  String   @id @default(uuid())
  version             Int      @unique // Monotonic, dir name = v{version}
  status              String   @default("training") // training, ready, failed
  trainingSampleCount Int      @default(0)
  metricsJson         String?  // JSON: holdout metrics (meanIoU, precision, recall, f1, countAcc, aspectAcc)
  hyperparamsJson     String?  // JSON: trainer hyperparameters
  notes               String?  // Free-form notes / failure message
  createdAt           DateTime @default(now())

  suggestions AISuggestion[]
  evaluations EvaluationRun[]
}

// Module 3 AI: Auto-Crop — a single AI-suggested crop rectangle.
// Suggestions are NOT real Crop rows until the user accepts one.
// modelId is null when produced by the rule-based Stage-A fallback (cold start).
model AISuggestion {
  id            String   @id @default(uuid())
  modelId       String?  // Null for rule-based (untrained) suggestions
  cropSessionId String
  chapterId     String
  rectJson      String   // JSON: canvas-space rect { canvasX, canvasY, canvasW, canvasH }
  aspectPreset  String   @default("free")
  confidence    Float    @default(0)
  status        String   @default("pending") // pending, accepted, adjusted, rejected
  rating        String?  // Blind-test feedback: "up" | "down"
  finalRectJson String?  // What the user actually kept (set when accepted/adjusted)
  createdAt     DateTime @default(now())

  model   AIModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  session CropSession @relation(fields: [cropSessionId], references: [id], onDelete: Cascade)
  chapter Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([cropSessionId])
  @@index([chapterId])
}

// Module 3 AI: Auto-Crop — a recorded evaluation pass over held-out chapters.
// modelId is null for rule-based (untrained) evaluation runs.
model EvaluationRun {
  id          String   @id @default(uuid())
  modelId     String?  // Null for rule-based (untrained) evaluation
  mode        String   @default("holdout") // holdout, blind
  chapterIds  String   // JSON: array of chapter ids evaluated
  metricsJson String   // JSON: aggregate + per-chapter metrics
  createdAt   DateTime @default(now())

  model AIModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
}

// ============ Module 3 v2: Image Clipper 2.0 ============

// One four-point pointer set per chapter.
//
// This row is an INDEX of an on-disk artifact, not the artifact itself: the
// pointer geometry lives in <chapter folder>/crop_points/crop_points.json,
// which the user can inspect, hand-edit and re-apply. That file is the source
// of truth — this row only carries what listing and status need (counts, the
// lifecycle status, provenance and where the export landed), so a stale or
// missing row can never change how a chapter crops.
//
// jsonPath is the resolved path of that artifact; imageLabel/Width/Height record
// the logical page the pointers were measured on (OUT-14), which for a stitched
// chapter is the combined canvas rather than any single file (ST-09).
model CropPointSet {
  id            String   @id @default(uuid())
  chapterId     String   @unique
  jsonPath      String   // Resolved path of crop_points.json (the real artifact)
  format        String   @default("four-point-crop")
  formatVersion String   @default("1.0")
  cropCount     Int      @default(0)
  status        String   @default("detected") // detecting, detected, edited, applied, failed
  source        String   @default("ai")       // ai, manual
  model         String?  // Vision model id, null for hand-authored point sets
  guidelinesSha String?  // sha256 of the guidelines text detection ran against
  imageLabel    String?  // image.filename from the artifact ("[stitched:N]" when combined)
  imageWidth    Int      @default(0)
  imageHeight   Int      @default(0)
  pageCount     Int      @default(0)
  warningsJson  String?  // JSON: ValidationIssue[] surfaced by the last run
  error         String?  // Failure message when status = "failed"
  exportDir     String?  // crops2/ — kept separate from v1's crops/
  exportedCount Int      @default(0)
  appliedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// ============ Module 4: Video Editor ============

// A compiled export project: one or more chapters stitched into a continuous video.
model VideoProject {
  id                String   @id @default(uuid())
  seriesId          String
  name              String   @default("Untitled Video")
  chapterIds        String   // JSON array of chapter ids included in this export, in order
  status            String   @default("draft") // draft | rendering | done | failed
  // Music + audio mix
  musicTrackId      String?
  masterVolume      Float    @default(1.0)   // 0.0 – 1.0, whole-video master
  musicVolume       Float    @default(0.25)  // 0.0 – 1.0, BG music level under narration
  // Editor-managed end title card (fixed duration; no outro audio in the pipeline)
  titleCardText     String?  // editable end-card override; null = auto (series title + default line)
  titleCardDuration Float    @default(5.0)   // seconds the end card is shown
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  series     Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  musicTrack MusicTrack?      @relation(fields: [musicTrackId], references: [id], onDelete: SetNull)
  parts      VideoPartEdit[]
  exports    VideoExport[]
  events     VideoEditEvent[]
}

// One row per script part included in the project (mirrors AudioSection),
// plus a final outro end-card row (isOutro = true, audioSectionId = null).
model VideoPartEdit {
  id             String   @id @default(uuid())
  projectId      String
  chapterId      String   // tag of the originating chapter (plain id, no relation)
  audioSectionId String?  // master-clock AudioSection; null for the outro end card
  orderIndex     Int      // global order across all chapters in the project
  isOutro        Boolean  @default(false) // true → renders title card, no images
  audioDuration  Float    // cached seconds (section audio, or end-card duration for outro)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project VideoProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images  VideoPartImage[]
}

model VideoPartImage {
  id              String   @id @default(uuid())
  partEditId      String
  cropId          String?  // null when isFiller = true
  imagePath       String?  // absolute path to the exported crop image; null for filler
  isFiller        Boolean  @default(false) // black/blank frame
  slotIndex       Int      // position within the part; ALWAYS derived from crop order
  duration        Float    // seconds; sum of a part's images == part audioDuration
  // Motion
  motionMode      String   @default("drift") // drift | focus
  motionEffect    String   @default("zoom-in") // gentle set: zoom-in | zoom-out | pan-left | pan-right | pan-up | pan-down
  motionIntensity Float    @default(0.04)  // slow by default
  anchorX         Float?   // 0–1, used when motionMode = focus
  anchorY         Float?   // 0–1
  // Manual foreground transform overrides (defaults computed by renderer)
  scale           Float?   // null = auto (fit height / 75% width rule)
  offsetX         Float?   // null = centered
  offsetY         Float?
  source          String   @default("manual") // manual | ai-suggested-accepted | ai-suggested-edited
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partEdit VideoPartEdit @relation(fields: [partEditId], references: [id], onDelete: Cascade)
}

model MusicTrack {
  id        String   @id @default(uuid())
  filename  String
  filePath  String   // absolute path on local disk
  createdAt DateTime @default(now())

  projects VideoProject[]
}

model VideoExport {
  id          String   @id @default(uuid())
  projectId   String
  outputPath  String
  resolution  String       // e.g. "1920x1080"
  preset      String       @default("medium")
  fileSizeMb  Float?
  durationSec Float?
  status      String       @default("pending") // pending | rendering | done | failed
  errorMsg    String?
  createdAt   DateTime     @default(now())

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// AI training / event log — mirrors the CropEvent approach from the Clipper.
model VideoEditEvent {
  id          String   @id @default(uuid())
  projectId   String
  partEditId  String?
  eventType   String   // image_selected | image_deselected | duration_adjusted | motion_changed |
                       // anchor_set | anchor_moved | image_transformed | filler_used |
                       // suggestion_accepted | suggestion_edited | suggestion_rejected
  payloadJson String   // event-specific data (crop id, old/new duration, motion type+intensity, x/y, etc.)
  createdAt   DateTime @default(now())

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Editor 2.0 — each chapter's pasted timeline JSON and the exact paste that
// last processed successfully (what turns Start Processing into Preview).
// Kept here rather than only in the browser so Chrome and the desktop app see
// the same chapters as processed. One row per chapter and narration language
// (English and Hindi are edited as separate videos), plain id (no relation).
model Editor2Timeline {
  model         String?  // AI recorded by the phone for this exact timeline
  chapterId     String
  language      String   @default("en") // en | hi
  json          String   // "" once cleared — kept so other browsers drop their copy too
  processedJson String?  // null = not processed
  updatedAt     DateTime // the client's write time; the newest write wins

  @@id([chapterId, language])
}

// ─── Studio AntiGravity: Google Drive connection (docs/PRD-antigravity-studio.md §4, §15) ───
// Secrets never live here: the OAuth client secret and each refresh token sit
// in the macOS Keychain, referenced by an opaque `secretRef`. The generic
// Setting table is readable through GET /api/settings, so nothing from Drive
// goes there either.

// The imported Desktop-app OAuth client. One row ("default"); importing a new
// client JSON replaces it.
model DriveOAuthClient {
  id         String   @id // "default"
  clientId   String   // public client ID (…apps.googleusercontent.com)
  projectId  String?
  secretRef  String   // Keychain account holding the client secret
  importedAt DateTime @default(now())
}

// One authorized Google account, unique per OAuth client + Google subject, so
// switching accounts keeps the old account's row and folder mappings.
model DriveConnection {
  id            String    @id @default(uuid())
  clientId      String
  googleSubject String    // stable Google account ID (`sub`)
  email         String    // verified display email
  scopes        String    // granted scopes, space separated
  secretRef     String    // Keychain account holding the refresh token
  active        Boolean   @default(false) // the one connection new work uses
  status        String    // connected | reconnect_required | disconnected | error
  lastError     String?   // sanitized, user-facing
  lastTestJson  String?   // sanitized result of the last Test connection
  connectedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([clientId, googleSubject])
}

// Studio-owned Drive folders. IDs are authoritative; names are presentation.
// `intentId` is a pre-generated Drive file ID saved before the create call,
// so an uncertain create is reconciled by ID instead of creating a duplicate.
model DriveFolderMapping {
  id           String    @id @default(uuid())
  connectionId String
  kind         String    // root | series | chapters | chapter | page
  entityKey    String    // stable library identity ("root" for the root)
  folderId     String?   // set once Drive confirmed the folder
  intentId     String?   // pre-generated ID of an in-flight create
  parentId     String?
  name         String
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([connectionId, kind, entityKey])
  @@index([folderId])
}

// ─── Studio AntiGravity: prompt pack, runs, page jobs, attempts (PRD §9.1, §13, §15) ───

// Immutable prompt versions. kind: crop_rules | analysis | review. The current
// version per kind is the Setting "antigravityPromptCurrent" ({kind: id}).
model AntigravityPromptVersion {
  id        String   @id @default(uuid())
  kind      String
  content   String
  sha256    String
  origin    String   // e.g. "sleeper-cell v2 default", "edited in Studio"
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// One operator selection with pinned settings.
model AntigravityRun {
  id             String    @id @default(uuid())
  seriesId       String
  partNumber     Int
  connectionId   String?   // Drive connection the inputs went to
  engine         String    @default("antigravity") // antigravity (agy) | codex (ChatGPT through the Codex CLI)
  kind           String    @default("clipper") // clipper (crop pointers) | metadata (crop descriptions + English-script links)
  model          String
  effort         String?
  sandbox        Boolean   @default(true)
  concurrency    Int       @default(1)
  promptJson     String    // pinned prompt version ids + hashes
  selectionJson  String    // [{chapterId, filename}] as requested
  control        String    // draft | preparing | running | pause_requested | paused | stop_requested | stopped | completed | completed_with_errors | interrupted
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime  @updatedAt
}

// The stable work unit: one original page + source generation + pinned profile.
model AntigravityPageJob {
  id                 String   @id @default(uuid())
  runId              String
  seriesId           String
  chapterId          String
  filename           String
  kind               String   @default("clipper") // clipper | metadata (same page can have one of each)
  pageIndex          Int
  sourceSha256       String
  width              Int
  height             Int
  idempotencyKey     String   @unique
  stage              String   // pending … ready_for_human_review | needs_attention | failed | stale | cancelled | interrupted
  manifestJson       String?  // slice handoff (no secrets, no local paths)
  manifestSha256     String?
  driveFolderId      String?
  preexistingPointer String?  // sha256 of saved pointers when the job started, or "none"
  currentAttemptId   String?
  resultJson         String?  // final canonical pointer file
  resultSha256       String?
  importState        String?  // imported | conflict | skipped | failed
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([runId])
  @@index([chapterId, filename])
}

// One execution of a page job: its own workspace, conversation and MCP capability.
model AntigravityAttempt {
  id               String    @id @default(uuid())
  jobId            String
  number           Int
  status           String    // active | completed | needs_attention | failed | cancelled | interrupted
  stage            String    // analyzing | reviewing | validating | done
  capabilityHash   String    // sha256 of the MCP bridge token; the token itself is never stored
  conversationId   String?
  workspace        String
  cliVersion       String?
  engine           String    @default("antigravity") // the CLI that owns this attempt's conversation
  codexAccount     String?   // Codex engine: the Studio account (CODEX_HOME) whose ChatGPT sign-in runs this conversation
  requestedModel   String
  observedModel    String    @default("unknown")
  pid              Int?
  deliveredJson    String    @default("[]") // slice ids delivered through MCP this attempt
  analysisJson     String?
  analysisSha256   String?
  reviewStateJson  String?
  flow             String    @default("classic") // classic (one prompt) | steps (four-step flow; Gemini 3.8 Flash) | metadata
  stepsStateJson   String?   // four-step flow: where the page is (review/steps.ts StepsState); metadata: accepted crop records (metadataFlow.ts)
  reviewRounds     Int       @default(0)
  submissions      Int       @default(0)
  deniedActions    String?
  error            String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([jobId])
}

// Drive inputs per page generation; the file ID is reserved before upload.
model DriveInputFile {
  id           String   @id @default(uuid())
  connectionId String
  jobId        String
  sliceId      String   // s01… or handoff/prompt names
  fileId       String
  parentId     String
  name         String
  mime         String
  bytes        Int
  sha256       String
  state        String   // reserved | uploaded | verified
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jobId, sliceId])
}

// Bounded, append-only operational log.
model AntigravityEvent {
  seq       Int      @id @default(autoincrement())
  runId     String?
  jobId     String?
  attemptId String?
  type      String
  message   String
  at        DateTime @default(now())

  @@index([runId, seq])
  @@index([jobId, seq])
}

/// One R2 publication of one validated AntiGravity result (PRD §14, §15).
/// Local import state stays on AntigravityPageJob; this row is the R2 target only.
model AntigravityDelivery {
  id             String    @id @default(uuid())
  jobId          String
  attemptId      String?
  seriesId       String
  chapterId      String
  filename       String
  sourceSha256   String
  resultSha256   String
  resultBytes    Int
  /// "r2:<bucket>/<prefix>" — the resolved shared exchange root, recorded once.
  destination    String
  pointerKey     String
  envelopeKey    String
  envelopeSha256 String?
  indexKey       String
  indexRevision  Int?
  /// pending | published | failed
  state          String
  tries          Int       @default(0)
  error          String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([resultSha256, destination])
  @@index([jobId])
  @@index([chapterId, destination])
}
