
# ---- Kokoro TTS (local Gradio app) ----
# Optional local TTS provider. Selected in Settings > Voiceover > TTS Provider.
# Base URL the server talks to (also the port autostart launches on)
KOKORO_URL=http://127.0.0.1:7860
# Folder containing the Kokoro app.py + its .venv.
# Defaults to a "Kokoro" folder alongside this project.
# KOKORO_APP_DIR=/absolute/path/to/Kokoro
# Set to false to stop `npm run dev` from launching Kokoro
KOKORO_AUTOSTART=true
# Default Kokoro voice id (not the emoji label), e.g. hf_alpha, am_michael
KOKORO_DEFAULT_VOICE=hf_alpha

# ---- Vision / crop detection (Image Clipper 3.0 one-click Detect) ----
# Which model answers "where are the crops in this image".
# Also selectable in Settings > Crop 3.0 - Prompts > Crop Detection Model.
# qwen (local, default) | gemini | openai | anthropic
VISION_PROVIDER=qwen

# Qwen3-VL through a local Ollama server — no API key, nothing leaves the machine.
#   1. Install Ollama (https://ollama.com)
#   2. ollama pull qwen3-vl:4b
OLLAMA_URL=http://127.0.0.1:11434
QWEN_VL_MODEL=qwen3-vl:4b
# How long Ollama keeps the model in memory between pages; reloading per image
# dominates runtime on a chapter run.
OLLAMA_KEEP_ALIVE=10m

# Cloud alternatives. Each is listed in Settings but only selectable with a key.
# GEMINI_API_KEY is shared with narration; the others are vision-only today.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Override the per-provider vision model if needed:
# GEMINI_VISION_MODEL=gemini-3.5-flash
# OPENAI_VISION_MODEL=gpt-4o
# ANTHROPIC_VISION_MODEL=claude-sonnet-5
# How long to wait for one local Qwen call. Local VL inference on a tall manhwa
# page takes minutes on Apple-silicon CPU — the default is 30 minutes.
# OLLAMA_TIMEOUT_MS=1800000
