# ---- Library ----
# Folder every series lives under (pages, crops, scripts, audio, videos)
DOWNLOAD_ROOT=./downloads
# SQLite database (relative to server/prisma)
DATABASE_URL="file:./dev.db"
# Server port (the client's socket connects to 3002)
PORT=3002

# ---- Cloudflare R2 (the Sleeper-Cell phones' bucket) ----
# Where the phones' chapters, crops, scripts and voiceovers are fetched from. Easiest to set in
# Settings > Cloudflare (writes these lines, no restart). All four are required;
# restart the server if you edit them here by hand.
#   Account ID: Cloudflare dashboard > R2 > (right-hand panel) Account ID
#   Keys: R2 > Manage R2 API Tokens > Create API token (Object Read & Write)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Folder inside the bucket every series goes under (default Manhwa, which
# Sleeper-Cell reads). Set it empty to use the bucket root.
# R2_PREFIX=Manhwa
# Files uploaded in parallel per series (default 4)
# R2_CONCURRENCY=4
