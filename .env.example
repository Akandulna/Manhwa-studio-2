# Manhwa Studio Configuration

# Root folder for all downloaded manhwa
DOWNLOAD_ROOT=./downloads

# Maximum concurrent downloads
CONCURRENCY=3

# Delay between requests in milliseconds (helps avoid rate limiting)
REQUEST_DELAY_MS=500

# Server port (must match the Vite proxy target in client/vite.config.ts)
PORT=3002

# Database URL (SQLite)
DATABASE_URL="file:./dev.db"

# === Module 2: Narration Studio ===
# AI Provider (currently only gemini is implemented)
AI_PROVIDER=gemini

# AI Model name
AI_MODEL=gemini-3.5-flash

# Gemini API Key (get yours from https://aistudio.google.com/apikey)
# Required for API mode; leave empty to use Manual mode only
GEMINI_API_KEY=

# === Module 3 AI: Auto-Crop (optional) ===
# Requires Python 3.10+. Run `npm run ml:setup` to create the venv.
# Override the Python interpreter (defaults to server/ml/venv/bin/python3).
PYTHON_PATH=
# Minimum finalized crops required before the model can be trained.
AI_CROP_MIN_SAMPLES=30
# Model for the default Gemini guideline cropper (the active default crop engine).
# Defaults to AI_MODEL when unset. Free tier is ~20 requests/day PER MODEL, so set
# this to a different model than AI_MODEL if you hit the narration model's quota.
# NOTE: this is Module 3 v1 (AI Crop Lab) only — Image Clipper 2.0 uses CLIPPER2_MODEL
# below instead, so the two engines can be tuned independently.
AI_CROP_MODEL=

# === Image Clipper 2.0: four-pointer crop detection ===
# Detection asks Gemini to place four crop pointers per section, reading the Crop
# Detection Guidelines (server/ml/CROP_POINT_GUIDELINES.md) as the prompt. Uses the
# same GEMINI_API_KEY as above — no separate key needed.

# Model override, independent of AI_CROP_MODEL and AI_MODEL. Defaults to
# gemini-3.5-flash when unset.
CLIPPER2_MODEL=
